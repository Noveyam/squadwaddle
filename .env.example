# Local settings for a future private Discord test. The demo and tests need none.
# Copy to .env and keep .env private. Never put tokens in chat or source control.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
PILOT_GUILD_ID=
PILOT_CHANNEL_ID=
DB_PATH=./data/next-session.sqlite
HOST=127.0.0.1
PORT=3000

# Needed only when deliberately registering the slash command.
DISCORD_BOT_TOKEN=
# Set to yes only for an authorized registration in your test server.
REGISTER_COMMANDS=no
